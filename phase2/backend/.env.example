# ------------------------------------------------------------------
# Drug Detective — BACKEND env (FastAPI on Render/Railway)
# Copy to .env and fill in. NEVER commit the real .env.
# ------------------------------------------------------------------

# Supabase (server-side). The SERVICE ROLE key bypasses Row Level Security and
# must stay backend-only — it is never sent to the browser. Leave both blank to
# run locally without Supabase (no caching / no persistence, pipeline still works).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS: comma-separated list of allowed frontend origins.
# Dev default is localhost:3000; in prod set your Vercel URL, e.g.:
# ALLOWED_ORIGINS=https://drug-detective.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to the Phase 1 project root (contains src/). Defaults to ../../phase1.
# Override only if you relocate phase1.
# PHASE1_ROOT=/absolute/path/to/phase1

# ---- Phase 1's own config (used by the imported pipeline) --------------------
# These mirror phase1/.env; the adapter also auto-loads phase1/.env if present.
OPEN_TARGETS_API_URL=https://api.platform.opentargets.org/api/v4/graphql
CHEMBL_API_URL=https://www.ebi.ac.uk/chembl/api/data
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2

# ---- Phase 3 evidence layers (all OPTIONAL) ---------------------------------
# PubMed works with no key at ~3 req/s; a free NCBI key raises it to ~10 req/s.
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# OpenAI powers DISPLAY-ONLY literature summaries. WITHOUT this key the app runs
# fully — it just shows the paper list without an AI summary. Never used for scoring.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
# openFDA works with no key; a free key raises rate limits.
OPENFDA_API_KEY=

# Evidence enrichment tuning (safe defaults; raise for deeper but slower searches).
MAX_EVIDENCE_ENRICHMENT=40   # candidates that get PubMed/FDA/trials lookups + re-rank
DISPLAY_TOP_N=10             # top cards that get a paper list + LLM summary
ENABLE_LITERATURE=1
ENABLE_SAFETY=1
ENABLE_TRIALS=1

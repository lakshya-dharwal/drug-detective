# ------------------------------------------------------------------
# Drug Detective — FRONTEND env (Next.js on Vercel)
# Copy to .env.local. Only NEXT_PUBLIC_* vars are exposed to the browser.
# ------------------------------------------------------------------

# FastAPI backend base URL (Render/Railway URL in prod; localhost in dev).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase — browser-safe values ONLY.
# The anon key is designed to be public and is safe here; it is gated by RLS.
# NEVER put the service_role key in any NEXT_PUBLIC_* variable — it belongs on
# the backend only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URLs (overridable for testing against mocks/proxies)
OPEN_TARGETS_API_URL=https://api.platform.opentargets.org/api/v4/graphql
CHEMBL_API_URL=https://www.ebi.ac.uk/chembl/api/data

# Cache
CACHE_DIR=data/api_cache
ENTITY_CACHE_PATH=data/entity_cache.json
CACHE_EXPIRY_DAYS=30

# HTTP behavior
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2

# Phase 3 evidence layers (all optional; pipeline degrades gracefully without them)
NCBI_API_KEY=          # PubMed: ~3 req/s without, ~10 req/s with a free key
OPENFDA_API_KEY=       # openFDA: higher rate limits with a free key
OPENAI_API_KEY=        # display-only literature summaries; NEVER used for scoring
OPENAI_SUMMARY_MODEL=gpt-4o-mini
MAX_EVIDENCE_ENRICHMENT=40
DISPLAY_TOP_N=10
ENABLE_LITERATURE=1
ENABLE_SAFETY=1
ENABLE_TRIALS=1
